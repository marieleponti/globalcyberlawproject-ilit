# Keep the build context small and out of the image.

.git
.gitignore
.idea
.vscode

# Source PDFs used to build the dataset offline. Roughly 45MB, never read at
# runtime, and the largest single win in image size.
scripts/

# Secrets. These arrive as environment variables at run time, never baked in.
.env
.env.*
!.env.production.example

# Regenerated by collectstatic on every container start.
src/staticfiles/

# Unused local database; the app runs on Postgres.
src/db.sqlite3

# Docker matches these with Go path globbing, so ** is required to reach
# nested directories. A bare __pycache__ would only match at the root.
**/__pycache__
**/*.py[cod]
**/*.so
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Working copies of the dataset, superseded by the checked-in CSVs.
**/*.bak

# Operational output, generated on the Droplet.
backups/
ops/reports/

# Documentation. Useful in the repo, dead weight in the image.
*.md
images/

# Operational scripts run on the Droplet host, not inside the container.
ops/
nginx/
docker-compose*.yml
.github/
