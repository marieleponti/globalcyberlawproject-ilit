# Production environment for the DigitalOcean Droplet.
#
# Copy to .env.production on the Droplet, fill in every value, then:
#   chmod 600 .env.production
#
# .env.production is gitignored. It must never be committed.

# --- Django core ------------------------------------------------------------
DEBUG=False

# Generate a fresh one, do not reuse the Render key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=CHANGE_ME

# Comma-separated. No scheme, no trailing slash, no port.
ALLOWED_HOSTS=nationalstatements.org,www.nationalstatements.org

# Optional. Derived from ALLOWED_HOSTS (https://) when left blank.
# CSRF_TRUSTED_ORIGINS=https://nationalstatements.org,https://www.nationalstatements.org

# Set to True to keep the site behind login. Flip to False on launch day.
REQUIRE_LOGIN=True

# Move the admin off the default path. Must end with a slash.
DJANGO_ADMIN_URL=admin/

# The same path without the trailing slash. Nginx uses it to apply the strict
# login rate limit to the admin. If you move the admin, change both or the
# admin silently falls back to the general, much looser limit.
ADMIN_PATH_RE=admin

DJANGO_LOG_LEVEL=INFO

# --- TLS --------------------------------------------------------------------
# Nginx already redirects http to https. Leaving Django's redirect on as well is
# harmless and covers any direct hit on the container.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS: start at 0. After TLS is confirmed on the real domain, raise to 3600,
# then to 31536000. A non-zero value on a domain without a valid certificate
# locks browsers out, and browsers honour the old value until it expires.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# The entrypoint fails the boot on any deployment warning. Checks deferred on
# purpose go here, one at a time, rather than lowering the gate for everything.
# security.W004 is the HSTS warning; remove it once HSTS is raised.
SILENCED_SYSTEM_CHECKS=security.W004

# --- Nginx (docker-compose.prod.yml) ---------------------------------------
# DOMAIN is the canonical host; everything else redirects to it.
DOMAIN=nationalstatements.org
WWW_DOMAIN=www.nationalstatements.org
# Mirrors SECURE_HSTS_SECONDS. Nginx emits the header for static responses too.
HSTS_MAX_AGE=0

# Where Let's Encrypt sends expiry warnings.
CERTBOT_EMAIL=admin@example.org

# --- Database ---------------------------------------------------------------
# Postgres runs as a container on the internal Docker network, so DATABASE_URL
# stays unset and these are used instead. DB_HOST is injected by compose.
POSTGRES_DB=natstatevis
POSTGRES_USER=natstatevis
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# Only relevant if you switch to DigitalOcean Managed Postgres, which requires
# DATABASE_URL and SSL.
# DATABASE_URL=postgresql://user:pass@host:25060/db
# DATABASE_SSL_REQUIRE=True

# --- Gunicorn ---------------------------------------------------------------
# The usual (2 x vCPU) + 1 rule assumes workers spend most of their time
# waiting on I/O. This app does not: it renders Plotly figures per request,
# which is CPU-bound. Extra workers on a single core do not add throughput,
# they just multiply memory and slow every request down.
#
# Each worker loads Django, pandas, numpy, plotly and matplotlib, which costs
# roughly 250-400 MB resident once warm.
#
#   1 vCPU / 2 GB  ->  2 workers   (the s-1vcpu-2gb Droplet)
#   2 vCPU / 4 GB  ->  4 workers
#
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Email (contact form, via Resend) --------------------------------------
# DigitalOcean blocks outbound SMTP (ports 25, 465 and 587) on new accounts, so
# the SMTP backend times out on the Droplet no matter how it is configured.
# Send over https instead. Do not switch this back to the SMTP backend without
# first confirming those ports are open from inside the web container.
EMAIL_BACKEND=core.email_backends.ResendAPIBackend

# The Resend API key. It is the same string Resend gives you as the SMTP
# password, and the backend falls back to EMAIL_HOST_PASSWORD if this is empty.
RESEND_API_KEY=CHANGE_ME

# Only used if you deliberately switch EMAIL_BACKEND back to SMTP, for example
# on a host that does not block those ports.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@nationalstatements.org
CONTACT_RECIPIENT_EMAIL=contact@nationalstatements.org

# --- Bootstrap superuser (optional) ----------------------------------------
# Only used on first boot, and only if both username and password are set.
# Remove both lines once the account exists.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# --- Backups ----------------------------------------------------------------
# Passphrase for the encrypted nightly dumps written by ops/backup.sh.
# Generate with: openssl rand -base64 32
# Store it somewhere other than this Droplet, or the backups are unrecoverable.
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_RETENTION_DAYS=30
