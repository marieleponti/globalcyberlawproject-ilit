# Reverse proxy for the EB site (everywhereborder.org), which runs in its own
# docker-compose stack (the sibling `eb-site-migracion/infra` project) but shares
# this Droplet's nginx for ports 80/443, the same way default.conf.template does
# for the Django app.
#
# OFF BY DEFAULT. nginx only loads *.template files from nginx/templates/, and
# this one lives outside it with an .example suffix, so merging it changes
# nothing for the Django site. To switch the EB site on, on the Droplet:
#
#   1. set EB_FRONTEND_DOMAIN and EB_WP_DOMAIN in .env.production (real,
#      non-empty, DNS already pointing here)
#   2. ./ops/issue-cert.sh <each domain>   (writes a placeholder certificate
#      first, so step 3 can never leave nginx without a file it needs)
#   3. cp nginx/eb-site.conf.template.example nginx/templates/eb-site.conf.template
#   4. docker compose -f docker-compose.prod.yml --env-file .env.production up -d nginx
#
# The copy in step 3 is git-ignored, so a Django deploy (git reset --hard) never
# removes it. To switch it off again, delete that copy and redo step 4.
#
# Does NOT redeclare `map $host $is_canonical` or a `# 10 requests/second per address for the app itself. A single-page app loads a
# few dozen files per visit, so the 60/minute used for the Django site would
# return 503 to ordinary visitors. Logins get their own, much tighter zone.
limit_req_zone $binary_remote_addr zone=eb_general_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=eb_login_limit:10m rate=5r/m;

# ---------------------------------------------------------------------------
# Frontend: everywhereborder.org
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name ${EB_FRONTEND_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://${EB_FRONTEND_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${EB_FRONTEND_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${EB_FRONTEND_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${EB_FRONTEND_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    server_tokens off;

    # The Node server does not compress; the JS/CSS bundles are large.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/xml image/svg+xml;

    # Docker's embedded DNS, asked at request time. A literal hostname in
    # proxy_pass is resolved once at nginx START, and if the EB containers are
    # not up yet nginx refuses to start ("host not found in upstream") — for
    # every site on this nginx, the Django one included. Going through a
    # variable defers the lookup to the first request instead.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $eb_frontend http://eb_frontend:3000;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        limit_req zone=eb_general_limit burst=100 nodelay;
        # No URI after the variable: nginx forwards the original request URI.
        proxy_pass $eb_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}

# ---------------------------------------------------------------------------
# Backend: admin.everywhereborder.org (WordPress)
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name ${EB_WP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://${EB_WP_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${EB_WP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${EB_WP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${EB_WP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    server_tokens off;

    client_max_body_size 100M;

    # Same lazy lookup as the frontend block above.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $eb_wp http://eb_wp_nginx:80;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Nothing in this stack uses XML-RPC, and it is a classic brute-force path.
    location = /xmlrpc.php {
        return 403;
    }

    # Only the login form is on the tight limit. wp-admin pages load dozens of
    # assets and must stay on the general one.
    location = /wp-login.php {
        limit_req zone=eb_login_limit burst=5 nodelay;
        proxy_pass $eb_wp;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location / {
        limit_req zone=eb_general_limit burst=100 nodelay;
        proxy_pass $eb_wp;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
